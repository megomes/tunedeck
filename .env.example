# sha256 of the UPPERCASED access code. Generate with:
#   printf '%s' 'MYCODE' | shasum -a 256
ACCESS_CODE_HASH=
# 32+ random chars used to sign session tokens: openssl rand -base64 48
SESSION_SECRET=

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Neon Object Storage (S3-compatible) for PDF/MIDI attachments
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=attachments

# Optional: YouTube Data API key. Without it, oEmbed + the watch page are used.
YOUTUBE_API_KEY=
